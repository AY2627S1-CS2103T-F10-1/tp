@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam NoteFontSize 11
skinparam SequenceMessageAlign left

title Successful execution of edit 1 /phone 91234567

box Logic LOGIC_COLOR_T1
participant ":EditCommandParser" as EditCommandParser LOGIC_COLOR
participant "d:EditPersonDescriptor" as EditPersonDescriptor LOGIC_COLOR
participant "phone:PersonField" as PersonField LOGIC_COLOR
participant "e:EditCommand" as EditCommand LOGIC_COLOR
participant "v:PersonFieldValues" as PersonFieldValues LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> EditCommandParser : parse("1 /phone 91234567")
activate EditCommandParser

create EditPersonDescriptor
EditCommandParser -> EditPersonDescriptor
EditCommandParser -> EditPersonDescriptor : setIfGiven(phone, args)
activate EditPersonDescriptor
EditPersonDescriptor -> PersonField : parseFrom(args)
PersonField --> EditPersonDescriptor : Phone
deactivate EditPersonDescriptor

create EditCommand
EditCommandParser -> EditCommand : EditCommand(index, d)
[<-- EditCommandParser : e
deactivate EditCommandParser

[-> EditCommand : execute(m)
activate EditCommand

EditCommand -> Model : getFilteredPersonList()
Model --> EditCommand : personToEdit

create PersonFieldValues
EditCommand -> PersonFieldValues : of(personToEdit)
note right: copies every field,\nincluding tags

EditCommand -> PersonFieldValues : putAll(d.values)
note right: overwrites the phone only

EditCommand -> PersonFieldValues : toPerson(email, address,\nemergency, isFavourite)
PersonFieldValues --> EditCommand : editedPerson

EditCommand -> Model : setPerson(personToEdit, editedPerson)

[<-- EditCommand : CommandResult
deactivate EditCommand
@enduml
