@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":TagCommandParser" as TagCommandParser LOGIC_COLOR
participant "t:TagCommand" as TagCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "p:Person" as Person MODEL_COLOR
end box

[-> LogicManager : execute("Sarah Tan /tag RA")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("Sarah Tan /tag RA")
activate AddressBookParser

note right of AddressBookParser
"Sarah" is not a command word, but the
input contains /tag (checked by the static
TagCommandParser.isTagCommand())
end note

create TagCommandParser
AddressBookParser -> TagCommandParser
activate TagCommandParser

TagCommandParser --> AddressBookParser
deactivate TagCommandParser

AddressBookParser -> TagCommandParser : parse("Sarah Tan /tag RA")
activate TagCommandParser

create TagCommand
TagCommandParser -> TagCommand : "Sarah Tan", RA
activate TagCommand

TagCommand --> TagCommandParser
deactivate TagCommand

TagCommandParser --> AddressBookParser : t
deactivate TagCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
TagCommandParser -[hidden]-> AddressBookParser
destroy TagCommandParser

AddressBookParser --> LogicManager : t
deactivate AddressBookParser

LogicManager -> TagCommand : execute(m)
activate TagCommand

TagCommand -> Model : getAddressBook().getPersonList()
activate Model
Model --> TagCommand : persons
deactivate Model

note right of TagCommand
finds p, whose name
matches "Sarah Tan"
end note

TagCommand -> Person : hasTag(RA)
activate Person
Person --> TagCommand : false
deactivate Person

TagCommand -> Person : isTagLimitReached()
activate Person
Person --> TagCommand : false
deactivate Person

TagCommand -> Person : withAddedTag(RA)
activate Person
Person --> TagCommand : taggedPerson
deactivate Person

TagCommand -> Model : setPerson(p, taggedPerson)
activate Model
Model --> TagCommand
deactivate Model

create CommandResult
TagCommand -> CommandResult
activate CommandResult

CommandResult --> TagCommand
deactivate CommandResult

TagCommand --> LogicManager : r
deactivate TagCommand

[<--LogicManager
deactivate LogicManager
@enduml
